PORT=8080
CORS_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=<replace-with-long-random-secret>
DATABASE_URL=postgres://appuser:<replace-with-long-random-secret>@postgres:5432/shopdb
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
SHOP_REQUIRE_API_AUTH=true
SHOP_API_TOKEN=<replace-with-long-random-admin-token>
SHOP_API_USERS=<replace-with-long-random-token>:user-1
TLS_CERT_PATH=
TLS_KEY_PATH=
